# Copy to .env and fill in. .env is gitignored — never commit tokens.
#
# Generate tokens at https://screeps.com/a/#!/account/auth-tokens
# Scope each token narrowly:
#   SCREEPS_TOKEN_DEPLOY — needs the code endpoints (POST /api/user/code)
#   SCREEPS_TOKEN_WATCH  — needs websocket console events
SCREEPS_TOKEN_DEPLOY=
SCREEPS_TOKEN_WATCH=

# Target server config name from your screeps config file.
SCREEPS_SERVER=main

# Shard to query. Seasonal/new shards change this; keep it configurable.
SCREEPS_SHARD=shard0

# Branch to upload to. Switching the *active* branch is a separate, metered
# operation (POST /api/user/set-active-branch, 240/day).
SCREEPS_BRANCH=default
